  "apiContracts": [
    {
      "endpoint": "/api/predict",
      "method": "POST",
      "operationId": "runInference",
      "parameters": [],
      "requestBodySchema": {
        "type": "object",
        "properties": {
          "prompt": { "type": "string" },
          "guidance_scale": { "type": "number", "default": 7.5 },
          "steps": { "type": "integer", "default": 50 }
        },
        "required": ["prompt"]
      },
      "responseBodySchema": {
        "type": "object",
        "properties": {
          "image_base64": { "type": "string" },
          "inference_ms": { "type": "number" }
        }
      },
      "authRequirements": {
