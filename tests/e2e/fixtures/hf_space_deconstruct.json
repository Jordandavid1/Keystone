  "workflowPatterns": [
    {
      "id": "wf_creative_diffusion",
      "patternType": "inference_pipeline",
      "triggerEvent": "submit_prompt",
      "steps": [
        {
          "sequence": 1,
          "action": "validate_parameters",
          "inputArtifacts": ["prompt_input", "guidance_scale", "steps"],
          "outputArtifacts": ["validated_request"],
          "latencyBenchmarkMs": 5
        },
        {
          "sequence": 2,
          "action": "execute_model_inference",
          "inputArtifacts": ["validated_request"],
          "outputArtifacts": ["image_tensor"],
          "latencyBenchmarkMs": 1420
        },
        {
          "sequence": 3,
          "action": "render_to_canvas",
          "inputArtifacts": ["image_tensor"],
          "outputArtifacts": ["canvas_viewport"],
          "latencyBenchmarkMs": 15
        }
      ],
      "errorRecovery": {
        "retryPolicy": "exponential_backoff_max_3",
        "fallbackState": "render_error_notification"
      }
    }
