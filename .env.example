# Copy to .env and fill the two values printed by
# KAGGLE_SETUP/notebooks/03_keystone_integrated_gateway.ipynb.
# .env is gitignored; never commit real values.

KEYSTONE_COMFY_URL=
KEYSTONE_COMFY_API_KEY=
